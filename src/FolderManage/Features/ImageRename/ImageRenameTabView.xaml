<UserControl x:Class="FolderManage.Features.ImageRename.ImageRenameTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:FolderManage.Common"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 대상 폴더 선택 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="대상 폴더" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding TargetFolderPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding RefreshCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="2" Content="찾아보기..." Margin="8,0,0,0" Padding="10,4"
                    Command="{Binding BrowseFolderCommand}" />
            <Button Grid.Column="3" Content="새로고침" Margin="8,0,0,0" Padding="10,4"
                    Command="{Binding RefreshCommand}"
                    ToolTip="대상 폴더의 폴더·파일을 다시 읽어 이름 그룹 목록을 만듭니다." />
        </Grid>

        <!-- 접미사 목록: 파일(확장자 앞)과 폴더(이름 끝)를 따로 관리 -->
        <GroupBox Grid.Row="1" Header="접미사 (있어도 같은 이름으로 판단)" Margin="0,0,0,8">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 파일 접미사 -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="파일 (확장자 앞, 예: 001.debug.png)" Margin="0,0,0,2" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Suffixes}" SelectedItem="{Binding SelectedSuffix}"
                             Height="52" />
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewSuffixText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddSuffixCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="추가" Margin="4,0,0,0" Padding="10,2"
                                Command="{Binding AddSuffixCommand}" />
                        <Button Grid.Column="2" Content="삭제" Margin="4,0,0,0" Padding="10,2"
                                Command="{Binding RemoveSuffixCommand}" ToolTip="목록에서 선택한 파일 접미사를 삭제합니다." />
                    </Grid>
                </Grid>

                <!-- 폴더 접미사 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="폴더 (이름 끝, 예: 001_files)" Margin="0,0,0,2" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding FolderSuffixes}" SelectedItem="{Binding SelectedFolderSuffix}"
                             Height="52" />
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewFolderSuffixText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddFolderSuffixCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="추가" Margin="4,0,0,0" Padding="10,2"
                                Command="{Binding AddFolderSuffixCommand}" />
                        <Button Grid.Column="2" Content="삭제" Margin="4,0,0,0" Padding="10,2"
                                Command="{Binding RemoveFolderSuffixCommand}" ToolTip="목록에서 선택한 폴더 접미사를 삭제합니다." />
                    </Grid>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- 이름 그룹 목록 -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  common:NaturalSortBehavior.IsEnabled="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="공통 이름" Binding="{Binding CommonName}" Width="150" />
                <DataGridTextColumn Header="구성" Binding="{Binding CountText}" Width="130" />
                <DataGridTextColumn Header="항목" Binding="{Binding MembersText}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 새 이름 입력과 실행 버튼 -->
        <Grid Grid.Row="3" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="새 이름" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding PreviewCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Content="미리보기" Padding="14,6" Margin="0,0,8,0" Command="{Binding PreviewCommand}" />
                <Button Content="이름 변경" Padding="14,6" Margin="0,0,8,0" Command="{Binding RenameCommand}" />
                <Button Content="되돌리기" Padding="14,6" Command="{Binding UndoCommand}"
                        ToolTip="가장 최근에 바꾼 이름을 원래대로 되돌립니다. 앱을 종료하면 기록이 사라집니다." />
            </StackPanel>
        </Grid>

        <!-- 미리보기 목록 -->
        <DataGrid Grid.Row="4" ItemsSource="{Binding PreviewItems}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  common:NaturalSortBehavior.IsEnabled="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="변경 전" Binding="{Binding OldName}" Width="*" />
                <DataGridTextColumn Header="변경 후" Binding="{Binding NewName}" Width="*" />
                <DataGridTextColumn Header="종류" Binding="{Binding KindText}" Width="60" />
                <DataGridTextColumn Header="상태" Binding="{Binding StatusText}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 상태 메시지 -->
        <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
