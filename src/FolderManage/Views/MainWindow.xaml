<Window x:Class="FolderManage.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:FolderManage.Views"
        mc:Ignorable="d"
        Title="folder-manage" Height="560" Width="640"
        MinHeight="480" MinWidth="520"
        Icon="/Assets/AppIcon.ico">
    <TabControl Margin="4">
        <TabItem Header="폴더 만들기">
            <views:MakeFolderTabView Margin="12" DataContext="{Binding MakeFolder}" />
        </TabItem>
    </TabControl>
</Window>
